{
  "name": "tax-b2b-verify-engine",
  "private": true,
  "version": "1.0.0",
  "description": "Tax/VAT ID verification + B2B domain enrichment engine with signed audit-certificate PDFs, served to Stripe, HubSpot, Pipedrive, monday.com and Make.com.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm --filter @tbve/gateway build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "start": "node packages/gateway/dist/server.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
