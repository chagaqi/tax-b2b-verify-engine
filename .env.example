# --- Gateway ---
PORT=8787
PUBLIC_BASE_URL=https://verify.example.com
# Client IP for rate limits: false (socket), cloudflare (CF-Connecting-IP), or the number of
# trusted proxy hops in front of the gateway (true = 1). The client is that many entries from the
# right of X-Forwarded-For; leftmost entries are attacker-controlled and are never trusted.
TRUST_PROXY=false

# --- Secrets (generate with: openssl rand -base64 32) ---
# HMAC key for signed certificate download links and API-key hashing pepper.
APP_SECRET=
# Ed25519 PKCS#8 private key (base64) used to sign audit certificates.
# Generate: node packages/gateway/dist/server.mjs --generate-signing-key
CERT_SIGNING_KEY=

# --- Storage (optional: falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Registry ---
# "live" (default) queries EU VIES; "offline" uses checksum-only verification.
VIES_MODE=live
VIES_TIMEOUT_MS=6000
# Optional: your own EU VAT number, so VIES returns a consultation number (requestIdentifier).
VIES_REQUESTER_VAT=

# --- Billing ---
STRIPE_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
MONDAY_SIGNING_SECRET=
UPGRADE_URL_STRIPE=
UPGRADE_URL_POLAR=

# --- Marketplace app secrets ---
STRIPE_APP_SECRET=
HUBSPOT_CLIENT_SECRET=
PIPEDRIVE_JWT_SECRET=
PIPEDRIVE_BASIC_USER=
PIPEDRIVE_BASIC_PASSWORD=
MONDAY_CLIENT_SECRET=
