{
  "url": "https://verify.taxb2b.app/v1/usage",
  "method": "GET",
  "headers": {
    "x-api-key": "{{parameters.apiKey}}"
  },
  "response": {
    "metadata": {
      "type": "text",
      "value": "{{body.tenantId}} ({{body.plan.name}} plan)"
    },
    "error": {
      "message": "[{{statusCode}}] {{body.error.message}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.x-api-key"
    ]
  }
}
